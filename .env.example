# "local" (padrão, funciona sem backend, dados no navegador) ou "firebase"
VITE_DATA_PROVIDER=local

# Firebase (necessário apenas com VITE_DATA_PROVIDER=firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Pix — chave e dados do recebedor usados para gerar o QR Code (BR Code estático)
VITE_PIX_KEY=cereja@exemplo.com
VITE_PIX_MERCHANT_NAME=CEREJA ESMALTERIA
VITE_PIX_MERCHANT_CITY=SANTO AMARO

# Link de pagamento para cartão (ex.: Mercado Pago / InfinitePay). Vazio = modo demonstração
VITE_CARD_PAYMENT_URL=

# Envio do código de verificação por e-mail no modo local (https://www.emailjs.com, plano grátis).
# O template deve usar {{to_email}} como destinatário e {{code}} no corpo.
# Vazio = modo demonstração: o código aparece na tela.
# No modo Firebase isto não é usado: o Firebase envia um link de login para o e-mail.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
